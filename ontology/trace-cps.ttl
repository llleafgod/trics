@prefix : <https://w3id.org/trace-cps/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trace: <https://w3id.org/trace-cps/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <https://w3id.org/trace-cps/ontology> .

<https://w3id.org/trace-cps/ontology> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://w3id.org/trace-cps/ontology/0.1.0> ;
                                       owl:versionInfo "0.1.0" ;
                                       dcterms:title "TRACE-CPS Ontology"@en ;
                                       dcterms:description "An ontology for representing cyber threats, vulnerabilities, industrial assets, and cross-domain relations in CPS security."@en ;
                                       dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                       vann:preferredNamespacePrefix "trace" ;
                                       vann:preferredNamespaceUri "https://w3id.org/trace-cps/ontology#" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/trace-cps/ontology#causesResult
<https://w3id.org/trace-cps/ontology#causesResult> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                               <https://w3id.org/trace-cps/ontology#ICSTechnique>
                                                                             )
                                                               ] ;
                                                   rdfs:range <https://w3id.org/trace-cps/ontology#Result> ;
                                                   rdfs:comment "A campaign or ICS technique causes an operational consequence on the CPS." ;
                                                   rdfs:label "causes Result" .


###  https://w3id.org/trace-cps/ontology#communicatesWithController
<https://w3id.org/trace-cps/ontology#communicatesWithController> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <https://w3id.org/trace-cps/ontology#CommunicatingEntity> ;
                                                                 rdfs:range <https://w3id.org/trace-cps/ontology#Controller> ;
                                                                 rdfs:comment "A communicating entity (DAQ, HostComputer, RTU, or Sensor) communicates with a controller." ;
                                                                 rdfs:label "communicates With Controller" .


###  https://w3id.org/trace-cps/ontology#communicatesWithDAQ
<https://w3id.org/trace-cps/ontology#communicatesWithDAQ> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://w3id.org/trace-cps/ontology#HostComputer> ;
                                                          rdfs:range <https://w3id.org/trace-cps/ontology#DAQ> ;
                                                          rdfs:comment "A host computer communicates with a DAQ device." ;
                                                          rdfs:label "communicates With DAQ" .


###  https://w3id.org/trace-cps/ontology#communicatesWithRTU
<https://w3id.org/trace-cps/ontology#communicatesWithRTU> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain [ rdf:type owl:Class ;
                                                                        owl:unionOf ( <https://w3id.org/trace-cps/ontology#HostComputer>
                                                                                      <https://w3id.org/trace-cps/ontology#Sensor>
                                                                                    )
                                                                      ] ;
                                                          rdfs:range <https://w3id.org/trace-cps/ontology#RTU> ;
                                                          rdfs:comment "A host computer or sensor communicates with an RTU." ;
                                                          rdfs:label "communicates With RTU" .


###  https://w3id.org/trace-cps/ontology#containsTechnique
<https://w3id.org/trace-cps/ontology#containsTechnique> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/trace-cps/ontology#Tactic> ;
                                                        rdfs:range <https://w3id.org/trace-cps/ontology#Technique> ;
                                                        rdfs:comment "A tactic contains one or more techniques used to achieve it." ;
                                                        rdfs:label "contains Technique" .


###  https://w3id.org/trace-cps/ontology#controls
<https://w3id.org/trace-cps/ontology#controls> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/trace-cps/ontology#Controller> ;
                                               rdfs:range <https://w3id.org/trace-cps/ontology#Actuator> ;
                                               rdfs:comment "A controller drives an actuator to perform physical actions." ;
                                               rdfs:label "controls" .


###  https://w3id.org/trace-cps/ontology#hasActuatorVersionPair
<https://w3id.org/trace-cps/ontology#hasActuatorVersionPair> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                             rdfs:domain <https://w3id.org/trace-cps/ontology#Actuator> ;
                                                             rdfs:range <https://w3id.org/trace-cps/ontology#ActuatorFVP> ;
                                                             rdfs:comment "Relates an actuator to its firmware version pair." ;
                                                             rdfs:label "has Actuator Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasAssigner
<https://w3id.org/trace-cps/ontology#hasAssigner> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                  rdfs:range <https://w3id.org/trace-cps/ontology#Assigner> ;
                                                  rdfs:comment "Relates a CVE to the organization that assigned it." ;
                                                  rdfs:label "has Assigner" .


###  https://w3id.org/trace-cps/ontology#hasCNVDVulnerability
<https://w3id.org/trace-cps/ontology#hasCNVDVulnerability> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVulnerability> ;
                                                           rdfs:domain <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                           rdfs:range <https://w3id.org/trace-cps/ontology#CNVD> ;
                                                           rdfs:comment "Relates a device version pair to a CNVD vulnerability entry." ;
                                                           rdfs:label "has CNVD Vulnerability" .


###  https://w3id.org/trace-cps/ontology#hasCVEDescription
<https://w3id.org/trace-cps/ontology#hasCVEDescription> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                        rdfs:range <https://w3id.org/trace-cps/ontology#CVEDescription> ;
                                                        rdfs:comment "Relates a CVE entry to its structured description." ;
                                                        rdfs:label "has CVE Description" .


###  https://w3id.org/trace-cps/ontology#hasCVEVulnerability
<https://w3id.org/trace-cps/ontology#hasCVEVulnerability> rdf:type owl:ObjectProperty ;
                                                          rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVulnerability> ;
                                                          rdfs:domain <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                          rdfs:range <https://w3id.org/trace-cps/ontology#CVE> ;
                                                          rdfs:comment "Relates a device version pair to a CVE vulnerability entry." ;
                                                          rdfs:label "has CVE Vulnerability" .


###  https://w3id.org/trace-cps/ontology#hasCommunicationProtocolVersionPair
<https://w3id.org/trace-cps/ontology#hasCommunicationProtocolVersionPair> rdf:type owl:ObjectProperty ;
                                                                          rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                                          rdfs:domain <https://w3id.org/trace-cps/ontology#CommunicationProtocol> ;
                                                                          rdfs:range <https://w3id.org/trace-cps/ontology#CommunicationProtocolVP> ;
                                                                          rdfs:comment "Relates a communication protocol to its version pair." ;
                                                                          rdfs:label "has Communication Protocol Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasContainer
<https://w3id.org/trace-cps/ontology#hasContainer> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                   rdfs:range <https://w3id.org/trace-cps/ontology#Container> ;
                                                   rdfs:comment "Relates a CVE to its container record holding structured metadata." ;
                                                   rdfs:label "has Container" .


###  https://w3id.org/trace-cps/ontology#hasControllerVersionPair
<https://w3id.org/trace-cps/ontology#hasControllerVersionPair> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                               rdfs:domain <https://w3id.org/trace-cps/ontology#Controller> ;
                                                               rdfs:range <https://w3id.org/trace-cps/ontology#ControllerFVP> ;
                                                               rdfs:comment "Relates a controller to its firmware version pair." ;
                                                               rdfs:label "has Controller Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasDAQVersionPair
<https://w3id.org/trace-cps/ontology#hasDAQVersionPair> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                        rdfs:domain <https://w3id.org/trace-cps/ontology#DAQ> ;
                                                        rdfs:range <https://w3id.org/trace-cps/ontology#DAQFVP> ;
                                                        rdfs:comment "Relates a DAQ device to its firmware version pair." ;
                                                        rdfs:label "has DAQ Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasDataComponent
<https://w3id.org/trace-cps/ontology#hasDataComponent> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/trace-cps/ontology#DataSource> ;
                                                       rdfs:range <https://w3id.org/trace-cps/ontology#DataComponent> ;
                                                       rdfs:comment "Relates a data source to one of its data components." ;
                                                       rdfs:label "has Data Component" .


###  https://w3id.org/trace-cps/ontology#hasDetection
<https://w3id.org/trace-cps/ontology#hasDetection> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/trace-cps/ontology#Technique> ;
                                                   rdfs:range <https://w3id.org/trace-cps/ontology#DataComponent> ;
                                                   rdfs:comment "Relates a technique to the data components that can be used to detect it." ;
                                                   rdfs:label "has Detection" .


###  https://w3id.org/trace-cps/ontology#hasHMIVersionPair
<https://w3id.org/trace-cps/ontology#hasHMIVersionPair> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                        rdfs:domain <https://w3id.org/trace-cps/ontology#HMI> ;
                                                        rdfs:range <https://w3id.org/trace-cps/ontology#HMIVP> ;
                                                        rdfs:comment "Relates an HMI to its software version pair." ;
                                                        rdfs:label "has HMI Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasManufacture
<https://w3id.org/trace-cps/ontology#hasManufacture> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                                     rdfs:range <https://w3id.org/trace-cps/ontology#Manufacturer> ;
                                                     rdfs:comment "Relates a control-layer device to its manufacturer." ;
                                                     rdfs:label "has Manufacture" .


###  https://w3id.org/trace-cps/ontology#hasMitigation
<https://w3id.org/trace-cps/ontology#hasMitigation> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/trace-cps/ontology#Technique> ;
                                                    rdfs:range <https://w3id.org/trace-cps/ontology#Mitigation> ;
                                                    rdfs:comment "Relates a technique to a recommended mitigation measure." ;
                                                    rdfs:label "has Mitigation" .


###  https://w3id.org/trace-cps/ontology#hasPurpose
<https://w3id.org/trace-cps/ontology#hasPurpose> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                             <https://w3id.org/trace-cps/ontology#ThreatActor>
                                                                           )
                                                             ] ;
                                                 rdfs:range <https://w3id.org/trace-cps/ontology#Purpose> ;
                                                 rdfs:comment "The intended objective or goal pursued by a campaign or threat actor." ;
                                                 rdfs:label "has Purpose" .


###  https://w3id.org/trace-cps/ontology#hasRTUVersionPair
<https://w3id.org/trace-cps/ontology#hasRTUVersionPair> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                        rdfs:domain <https://w3id.org/trace-cps/ontology#RTU> ;
                                                        rdfs:range <https://w3id.org/trace-cps/ontology#RTUFVP> ;
                                                        rdfs:comment "Relates an RTU to its firmware version pair." ;
                                                        rdfs:label "has RTU Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasRelatedAsset
<https://w3id.org/trace-cps/ontology#hasRelatedAsset> rdf:type owl:ObjectProperty ,
                                                               owl:SymmetricProperty ;
                                                      rdfs:domain <https://w3id.org/trace-cps/ontology#Asset> ;
                                                      rdfs:range <https://w3id.org/trace-cps/ontology#Asset> ;
                                                      rdfs:comment "Relates an ATT&CK asset to another related asset." ;
                                                      rdfs:label "has Related Asset" .


###  https://w3id.org/trace-cps/ontology#hasRelatedCWE
<https://w3id.org/trace-cps/ontology#hasRelatedCWE> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                    rdfs:range <https://w3id.org/trace-cps/ontology#CWE> ;
                                                    rdfs:comment "Relates a CVE to the CWE weakness category it belongs to." ;
                                                    rdfs:label "has Related CWE" .


###  https://w3id.org/trace-cps/ontology#hasSensorVersionPair
<https://w3id.org/trace-cps/ontology#hasSensorVersionPair> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <https://w3id.org/trace-cps/ontology#hasVersionPair> ;
                                                           rdfs:domain <https://w3id.org/trace-cps/ontology#Sensor> ;
                                                           rdfs:range <https://w3id.org/trace-cps/ontology#SensorFVP> ;
                                                           rdfs:comment "Relates a sensor to its firmware version pair." ;
                                                           rdfs:label "has Sensor Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasVersionPair
<https://w3id.org/trace-cps/ontology#hasVersionPair> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain [ rdf:type owl:Class ;
                                                                   owl:unionOf ( <https://w3id.org/trace-cps/ontology#CommunicationProtocol>
                                                                                 <https://w3id.org/trace-cps/ontology#ControlLayer>
                                                                                 <https://w3id.org/trace-cps/ontology#PerceptionLayer>
                                                                               )
                                                                 ] ;
                                                     rdfs:range <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                     rdfs:comment "Relates a device or protocol to its firmware or software version pair." ;
                                                     rdfs:label "has Version Pair" .


###  https://w3id.org/trace-cps/ontology#hasVulnerability
<https://w3id.org/trace-cps/ontology#hasVulnerability> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                       rdfs:range <https://w3id.org/trace-cps/ontology#Vulnerability> ;
                                                       rdfs:comment "Relates a device version pair to a known vulnerability." ;
                                                       rdfs:label "has Vulnerability" .


###  https://w3id.org/trace-cps/ontology#isHostedOnHostComputer
<https://w3id.org/trace-cps/ontology#isHostedOnHostComputer> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <https://w3id.org/trace-cps/ontology#HMI> ;
                                                             rdfs:range <https://w3id.org/trace-cps/ontology#HostComputer> ;
                                                             rdfs:comment "Indicates that an HMI application is hosted on a host computer." ;
                                                             rdfs:label "is Hosted On Host Computer" .


###  https://w3id.org/trace-cps/ontology#launches
<https://w3id.org/trace-cps/ontology#launches> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/trace-cps/ontology#ThreatActor> ;
                                               rdfs:range <https://w3id.org/trace-cps/ontology#Campaign> ;
                                               rdfs:comment "A threat actor initiates and conducts a campaign." ;
                                               rdfs:label "launches" .


###  https://w3id.org/trace-cps/ontology#sendsDataToDAQ
<https://w3id.org/trace-cps/ontology#sendsDataToDAQ> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/trace-cps/ontology#Sensor> ;
                                                     rdfs:range <https://w3id.org/trace-cps/ontology#DAQ> ;
                                                     rdfs:comment "A sensor transmits measurement data to a DAQ device." ;
                                                     rdfs:label "sends Data To DAQ" .


###  https://w3id.org/trace-cps/ontology#supports
<https://w3id.org/trace-cps/ontology#supports> rdf:type owl:ObjectProperty ;
                                               rdfs:domain [ rdf:type owl:Class ;
                                                             owl:unionOf ( <https://w3id.org/trace-cps/ontology#Actuator>
                                                                           <https://w3id.org/trace-cps/ontology#CommunicatingEntity>
                                                                           <https://w3id.org/trace-cps/ontology#Controller>
                                                                         )
                                                           ] ;
                                               rdfs:range <https://w3id.org/trace-cps/ontology#CommunicationProtocol> ;
                                               rdfs:comment "A CPS device supports a communication protocol." ;
                                               rdfs:label "supports" .


###  https://w3id.org/trace-cps/ontology#targets
<https://w3id.org/trace-cps/ontology#targets> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/trace-cps/ontology#Tool> ;
                                              rdfs:range <https://w3id.org/trace-cps/ontology#Software> ;
                                              rdfs:comment "A tool targets or operates on a software or system component." ;
                                              rdfs:label "targets" .


###  https://w3id.org/trace-cps/ontology#targetsAsset
<https://w3id.org/trace-cps/ontology#targetsAsset> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/trace-cps/ontology#ICSTechnique> ;
                                                   rdfs:range [ rdf:type owl:Class ;
                                                                owl:unionOf ( <https://w3id.org/trace-cps/ontology#Asset>
                                                                              <https://w3id.org/trace-cps/ontology#ControlLayer>
                                                                              <https://w3id.org/trace-cps/ontology#NetworkLayer>
                                                                            )
                                                              ] ;
                                                   rdfs:comment "An ICS technique targets a CPS asset, control-layer device, or network component." ;
                                                   rdfs:label "targets Asset" .


###  https://w3id.org/trace-cps/ontology#usesInfrastructure
<https://w3id.org/trace-cps/ontology#usesInfrastructure> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain [ rdf:type owl:Class ;
                                                                       owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                                     <https://w3id.org/trace-cps/ontology#ThreatActor>
                                                                                   )
                                                                     ] ;
                                                         rdfs:range <https://w3id.org/trace-cps/ontology#Infrastructure> ;
                                                         rdfs:comment "A threat actor or campaign leverages technical infrastructure to support operations." ;
                                                         rdfs:label "uses Infrastructure" .


###  https://w3id.org/trace-cps/ontology#usesSoftware
<https://w3id.org/trace-cps/ontology#usesSoftware> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                               <https://w3id.org/trace-cps/ontology#ThreatActor>
                                                                             )
                                                               ] ;
                                                   rdfs:range <https://w3id.org/trace-cps/ontology#Software> ;
                                                   rdfs:comment "A threat actor or campaign uses a specific software tool or malware." ;
                                                   rdfs:label "uses Software" .


###  https://w3id.org/trace-cps/ontology#usesTechnique
<https://w3id.org/trace-cps/ontology#usesTechnique> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Class ;
                                                                  owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                                <https://w3id.org/trace-cps/ontology#ThreatActor>
                                                                              )
                                                                ] ;
                                                    rdfs:range <https://w3id.org/trace-cps/ontology#Technique> ;
                                                    rdfs:comment "A threat actor or campaign employs a specific ATT&CK technique." ;
                                                    rdfs:label "uses Technique" .


###  https://w3id.org/trace-cps/ontology#utilizes
<https://w3id.org/trace-cps/ontology#utilizes> rdf:type owl:ObjectProperty ;
                                               rdfs:domain [ rdf:type owl:Class ;
                                                             owl:unionOf ( <https://w3id.org/trace-cps/ontology#Campaign>
                                                                           <https://w3id.org/trace-cps/ontology#Tactic>
                                                                           <https://w3id.org/trace-cps/ontology#Technique>
                                                                           <https://w3id.org/trace-cps/ontology#ThreatActor>
                                                                         )
                                                           ] ;
                                               rdfs:range <https://w3id.org/trace-cps/ontology#Tool> ;
                                               rdfs:comment "A threat actor, campaign, technique, or tactic employs a specific tool." ;
                                               rdfs:label "utilizes" .


###  https://w3id.org/trace-cps/ontology#worksFor
<https://w3id.org/trace-cps/ontology#worksFor> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/trace-cps/ontology#SecurityTeam> ;
                                               rdfs:range <https://w3id.org/trace-cps/ontology#Identity> ;
                                               rdfs:comment "A security team is affiliated with a parent identity organization." ;
                                               rdfs:label "works For" .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/trace-cps/ontology#hasATTCKID
<https://w3id.org/trace-cps/ontology#hasATTCKID> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "The ATT&CK identifier of an entity (e.g., T1234, TA0001, G0001)." ;
                                                 rdfs:label "has ATT&CK ID" .


###  https://w3id.org/trace-cps/ontology#hasAnotherName
<https://w3id.org/trace-cps/ontology#hasAnotherName> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <https://w3id.org/trace-cps/ontology#ThreatActor> ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "An alias or alternative name used for a threat actor." ;
                                                     rdfs:label "has Another Name" .


###  https://w3id.org/trace-cps/ontology#hasAssignerName
<https://w3id.org/trace-cps/ontology#hasAssignerName> rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain <https://w3id.org/trace-cps/ontology#Assigner> ;
                                                      rdfs:range xsd:string ;
                                                      rdfs:comment "The name of the organization that assigned a CVE identifier." ;
                                                      rdfs:label "has Assigner Name" .


###  https://w3id.org/trace-cps/ontology#hasCVSSBaseScore
<https://w3id.org/trace-cps/ontology#hasCVSSBaseScore> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <https://w3id.org/trace-cps/ontology#CVECVSSVP> ;
                                                       rdfs:range xsd:string ;
                                                       rdfs:comment "The CVSS base score of a vulnerability (e.g., 7.5)." ;
                                                       rdfs:label "has CVSS Base Score" .


###  https://w3id.org/trace-cps/ontology#hasCVSSBaseSeverity
<https://w3id.org/trace-cps/ontology#hasCVSSBaseSeverity> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <https://w3id.org/trace-cps/ontology#CVECVSSVP> ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "The CVSS base severity rating (LOW, MEDIUM, HIGH, or CRITICAL)." ;
                                                          rdfs:label "has CVSS Base Severity" .


###  https://w3id.org/trace-cps/ontology#hasCVSSVectorString
<https://w3id.org/trace-cps/ontology#hasCVSSVectorString> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <https://w3id.org/trace-cps/ontology#CVECVSSVP> ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "The CVSS vector string encoding the scoring metrics (e.g., CVSS:3.1/AV:N/AC:L/...)." ;
                                                          rdfs:label "has CVSS Vector String" .


###  https://w3id.org/trace-cps/ontology#hasContainerName
<https://w3id.org/trace-cps/ontology#hasContainerName> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <https://w3id.org/trace-cps/ontology#Container> ;
                                                       rdfs:range xsd:string ;
                                                       rdfs:comment "The name of the container record associated with a CVE entry." ;
                                                       rdfs:label "has Container Name" .


###  https://w3id.org/trace-cps/ontology#hasDescription
<https://w3id.org/trace-cps/ontology#hasDescription> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "Textual description of an ATT&CK entity, used to support LLM-based entity alignment, graph fusion, and link prediction." ;
                                                     rdfs:label "has Description" .


###  https://w3id.org/trace-cps/ontology#hasLanguage
<https://w3id.org/trace-cps/ontology#hasLanguage> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <https://w3id.org/trace-cps/ontology#CVEDescription> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "The language code of a CVE description (e.g., en, zh)." ;
                                                  rdfs:label "has Language" .


###  https://w3id.org/trace-cps/ontology#hasPlatform
<https://w3id.org/trace-cps/ontology#hasPlatform> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "The platform or operating environment applicable to an ATT&CK entity (e.g., Windows, Linux, ICS)." ;
                                                  rdfs:label "has Platform" .


###  https://w3id.org/trace-cps/ontology#hasPublishedDate
<https://w3id.org/trace-cps/ontology#hasPublishedDate> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                       rdfs:range xsd:string ;
                                                       rdfs:comment "The date on which a CVE was published." ;
                                                       rdfs:label "has Published Date" .


###  https://w3id.org/trace-cps/ontology#hasReference
<https://w3id.org/trace-cps/ontology#hasReference> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <https://w3id.org/trace-cps/ontology#CVE>
                                                                               <https://w3id.org/trace-cps/ontology#ATT&CK>
                                                                             )
                                                               ] ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "A URL or identifier referencing an external source related to an ATT&CK entity or CVE." ;
                                                   rdfs:label "has Reference" .


###  https://w3id.org/trace-cps/ontology#hasRejectedDate
<https://w3id.org/trace-cps/ontology#hasRejectedDate> rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                      rdfs:range xsd:string ;
                                                      rdfs:comment "The date on which a CVE was rejected." ;
                                                      rdfs:label "has Rejected Date" .


###  https://w3id.org/trace-cps/ontology#hasTitle
<https://w3id.org/trace-cps/ontology#hasTitle> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                               rdfs:range xsd:string ;
                                               rdfs:comment "The title of a CVE entry." ;
                                               rdfs:label "has Title" .


###  https://w3id.org/trace-cps/ontology#hasType
<https://w3id.org/trace-cps/ontology#hasType> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/trace-cps/ontology#Actuator> ;
                                              rdfs:range xsd:string ;
                                              rdfs:comment "The functional type of an actuator (e.g., motor, valve, pump)." ;
                                              rdfs:label "has Type" .


###  https://w3id.org/trace-cps/ontology#hasUpdatedDate
<https://w3id.org/trace-cps/ontology#hasUpdatedDate> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <https://w3id.org/trace-cps/ontology#CVE> ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "The date on which a CVE was last updated." ;
                                                     rdfs:label "has Updated Date" .


###  https://w3id.org/trace-cps/ontology#hasValue
<https://w3id.org/trace-cps/ontology#hasValue> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/trace-cps/ontology#CVEDescription> ;
                                               rdfs:range xsd:string ;
                                               rdfs:comment "The textual content of a CVE description." ;
                                               rdfs:label "has Value" .


###  https://w3id.org/trace-cps/ontology#hasVersion
<https://w3id.org/trace-cps/ontology#hasVersion> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <https://w3id.org/trace-cps/ontology#CommunicationProtocol>
                                                                             <https://w3id.org/trace-cps/ontology#ControlLayer>
                                                                             <https://w3id.org/trace-cps/ontology#PerceptionLayer>
                                                                           )
                                                             ] ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "The software version or hardware firmware version of a device or protocol." ;
                                                 rdfs:label "has Version" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/trace-cps/ontology#Actuator
<https://w3id.org/trace-cps/ontology#Actuator> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                               rdfs:comment "A physical device in the control layer that executes commands from a controller (e.g., motor, valve, pump)." ;
                                               rdfs:label "Actuator" .


###  https://w3id.org/trace-cps/ontology#ActuatorFVP
<https://w3id.org/trace-cps/ontology#ActuatorFVP> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ,
                                                                  <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                  rdfs:comment "A pair associating an actuator with a specific firmware version." ;
                                                  rdfs:label "Actuator Firmware Version Pair" .


###  https://w3id.org/trace-cps/ontology#Asset
<https://w3id.org/trace-cps/ontology#Asset> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                            rdfs:comment "An ATT&CK ICS asset representing a technology or system component relevant to industrial environments." ;
                                            rdfs:label "Asset" .


###  https://w3id.org/trace-cps/ontology#Assigner
<https://w3id.org/trace-cps/ontology#Assigner> rdf:type owl:Class ;
                                               rdfs:comment "The organization (e.g., MITRE, NVD) that assigned a CVE identifier." ;
                                               rdfs:label "Assigner" .


###  https://w3id.org/trace-cps/ontology#CNVD
<https://w3id.org/trace-cps/ontology#CNVD> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Vulnerability> ;
                                           owl:disjointWith <https://w3id.org/trace-cps/ontology#CVE> ;
                                           rdfs:comment "A vulnerability entry from the China National Vulnerability Database." ;
                                           rdfs:label "CNVD" .


###  https://w3id.org/trace-cps/ontology#CVE
<https://w3id.org/trace-cps/ontology#CVE> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Vulnerability> ;
                                          rdfs:comment "A Common Vulnerabilities and Exposures entry identifying a publicly known cybersecurity vulnerability." ;
                                          rdfs:label "CVE" .


###  https://w3id.org/trace-cps/ontology#CVECVSSVP
<https://w3id.org/trace-cps/ontology#CVECVSSVP> rdf:type owl:Class ;
                                                rdfs:comment "A pair associating a CVE entry with its CVSS scoring information." ;
                                                rdfs:label "CVE CVSS Version Pair" .


###  https://w3id.org/trace-cps/ontology#CVEDescription
<https://w3id.org/trace-cps/ontology#CVEDescription> rdf:type owl:Class ;
                                                     rdfs:comment "A structured textual description of a CVE entry." ;
                                                     rdfs:label "CVE Description" .


###  https://w3id.org/trace-cps/ontology#CWE
<https://w3id.org/trace-cps/ontology#CWE> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Weakness> ;
                                          rdfs:comment "A Common Weakness Enumeration entry describing a type of software or hardware weakness." ;
                                          rdfs:label "CWE" .


###  https://w3id.org/trace-cps/ontology#Campaign
<https://w3id.org/trace-cps/ontology#Campaign> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                               rdfs:comment "A coordinated set of malicious activities or attacks attributed to a threat actor over a period of time." ;
                                               rdfs:label "Campaign" .


###  https://w3id.org/trace-cps/ontology#CommunicatingEntity
<https://w3id.org/trace-cps/ontology#CommunicatingEntity> rdf:type owl:Class ;
                                                          rdfs:comment "Abstract parent class for CPS devices that actively initiate communication with controllers or RTUs (DAQ, HostComputer, RTU, Sensor)." ;
                                                          rdfs:label "Communicating Entity" .


###  https://w3id.org/trace-cps/ontology#CommunicationProtocol
<https://w3id.org/trace-cps/ontology#CommunicationProtocol> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/trace-cps/ontology#NetworkLayer> ;
                                                            rdfs:comment "An industrial or network communication protocol used in CPS environments (e.g., Modbus, OPC UA, Profinet, DNP3)." ;
                                                            rdfs:label "Communication Protocol" .


###  https://w3id.org/trace-cps/ontology#CommunicationProtocolVP
<https://w3id.org/trace-cps/ontology#CommunicationProtocolVP> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/trace-cps/ontology#NetworkLayer> ,
                                                                              <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                              rdfs:comment "A pair associating a communication protocol with a specific version." ;
                                                              rdfs:label "Communication Protocol Version Pair" .


###  https://w3id.org/trace-cps/ontology#Container
<https://w3id.org/trace-cps/ontology#Container> rdf:type owl:Class ;
                                                rdfs:comment "The container record of a CVE entry holding structured vulnerability metadata." ;
                                                rdfs:label "Container" .


###  https://w3id.org/trace-cps/ontology#ControlLayer
<https://w3id.org/trace-cps/ontology#ControlLayer> rdf:type owl:Class ;
                                                   rdfs:comment "The control layer of a CPS architecture, comprising controllers, actuators, HMIs, host computers, and related devices." ;
                                                   rdfs:label "Control Layer" .


###  https://w3id.org/trace-cps/ontology#Controller
<https://w3id.org/trace-cps/ontology#Controller> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                                 rdfs:comment "An industrial controller (e.g., PLC, DCS) that receives commands from the supervisory system and drives actuators. RTU is modelled as a subclass." ;
                                                 rdfs:label "Controller" .


###  https://w3id.org/trace-cps/ontology#ControllerFVP
<https://w3id.org/trace-cps/ontology#ControllerFVP> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ,
                                                                    <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                                    rdfs:comment "A pair associating a controller with a specific firmware version." ;
                                                    rdfs:label "Controller Firmware Version Pair" .


###  https://w3id.org/trace-cps/ontology#DAQ
<https://w3id.org/trace-cps/ontology#DAQ> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#CommunicatingEntity> ,
                                                          <https://w3id.org/trace-cps/ontology#PerceptionLayer> ;
                                          owl:disjointWith <https://w3id.org/trace-cps/ontology#Sensor> ;
                                          rdfs:comment "A Data Acquisition device that collects measurement data from sensors and transmits it to controllers or host computers." ;
                                          rdfs:label "DAQ" .


###  https://w3id.org/trace-cps/ontology#DAQFVP
<https://w3id.org/trace-cps/ontology#DAQFVP> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/trace-cps/ontology#PerceptionLayer> ,
                                                             <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                             rdfs:comment "A pair associating a DAQ device with a specific firmware version." ;
                                             rdfs:label "DAQ Firmware Version Pair" .


###  https://w3id.org/trace-cps/ontology#DataComponent
<https://w3id.org/trace-cps/ontology#DataComponent> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                    rdfs:comment "A sub-category of a data source used to detect ATT&CK techniques." ;
                                                    rdfs:label "Data Component" .


###  https://w3id.org/trace-cps/ontology#DataSource
<https://w3id.org/trace-cps/ontology#DataSource> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                 rdfs:comment "An ATT&CK data source representing a system or artifact that can be used to detect adversary techniques." ;
                                                 rdfs:label "Data Source" .


###  https://w3id.org/trace-cps/ontology#EnterpriseMitigation
<https://w3id.org/trace-cps/ontology#EnterpriseMitigation> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Mitigation> ;
                                                           rdfs:comment "A mitigation measure defined in the ATT&CK Enterprise matrix." ;
                                                           rdfs:label "Enterprise Mitigation" .


###  https://w3id.org/trace-cps/ontology#EnterpriseTactic
<https://w3id.org/trace-cps/ontology#EnterpriseTactic> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Tactic> ;
                                                       rdfs:comment "A tactic defined in the ATT&CK Enterprise matrix." ;
                                                       rdfs:label "Enterprise Tactic" .


###  https://w3id.org/trace-cps/ontology#EnterpriseTechnique
<https://w3id.org/trace-cps/ontology#EnterpriseTechnique> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Technique> ;
                                                          rdfs:comment "A technique defined in the ATT&CK Enterprise matrix." ;
                                                          rdfs:label "Enterprise Technique" .


###  https://w3id.org/trace-cps/ontology#Gateway
<https://w3id.org/trace-cps/ontology#Gateway> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/trace-cps/ontology#NetworkLayer> ;
                                              rdfs:comment "A network gateway connecting different network segments within a CPS environment." ;
                                              rdfs:label "Gateway" .


###  https://w3id.org/trace-cps/ontology#HMI
<https://w3id.org/trace-cps/ontology#HMI> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                          rdfs:comment "A Human-Machine Interface providing operators with a graphical view of the industrial process and control capabilities." ;
                                          rdfs:label "HMI" .


###  https://w3id.org/trace-cps/ontology#HMIVP
<https://w3id.org/trace-cps/ontology#HMIVP> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ,
                                                            <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                            rdfs:comment "A pair associating an HMI with a specific software version." ;
                                            rdfs:label "HMI Software Version Pair" .


###  https://w3id.org/trace-cps/ontology#HostComputer
<https://w3id.org/trace-cps/ontology#HostComputer> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/trace-cps/ontology#CommunicatingEntity> ,
                                                                   <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                                   rdfs:comment "The supervisory host computer in a CPS that issues high-level commands to controllers and hosts SCADA or HMI software." ;
                                                   rdfs:label "Host Computer" .


###  https://w3id.org/trace-cps/ontology#ICSMitigation
<https://w3id.org/trace-cps/ontology#ICSMitigation> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Mitigation> ;
                                                    rdfs:comment "A mitigation measure defined in the ATT&CK ICS matrix." ;
                                                    rdfs:label "ICS Mitigation" .


###  https://w3id.org/trace-cps/ontology#ICSTactic
<https://w3id.org/trace-cps/ontology#ICSTactic> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Tactic> ;
                                                rdfs:comment "A tactic defined in the ATT&CK ICS matrix." ;
                                                rdfs:label "ICS Tactic" .


###  https://w3id.org/trace-cps/ontology#ICSTechnique
<https://w3id.org/trace-cps/ontology#ICSTechnique> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Technique> ;
                                                   rdfs:comment "A technique defined in the ATT&CK ICS matrix." ;
                                                   rdfs:label "ICS Technique" .


###  https://w3id.org/trace-cps/ontology#Identity
<https://w3id.org/trace-cps/ontology#Identity> rdf:type owl:Class ;
                                               rdfs:comment "The parent organization of a security team or threat actor." ;
                                               rdfs:label "Identity" .


###  https://w3id.org/trace-cps/ontology#Infrastructure
<https://w3id.org/trace-cps/ontology#Infrastructure> rdf:type owl:Class ;
                                                     rdfs:comment "The technical infrastructure used by threat actors to support their operations (e.g., C2 servers, botnets)." ;
                                                     rdfs:label "Infrastructure" .


###  https://w3id.org/trace-cps/ontology#Manufacturer
<https://w3id.org/trace-cps/ontology#Manufacturer> rdf:type owl:Class ;
                                                   rdfs:comment "The manufacturer of a CPS device (e.g., Siemens, Schneider Electric, Rockwell Automation)." ;
                                                   rdfs:label "Manufacturer" .


###  https://w3id.org/trace-cps/ontology#Mitigation
<https://w3id.org/trace-cps/ontology#Mitigation> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                                 rdfs:comment "An ATT&CK-defined mitigation measure that reduces the effectiveness of an adversary technique." ;
                                                 rdfs:label "Mitigation" .


###  https://w3id.org/trace-cps/ontology#MobileMitigation
<https://w3id.org/trace-cps/ontology#MobileMitigation> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Mitigation> ;
                                                       rdfs:comment "A mitigation measure defined in the ATT&CK Mobile matrix." ;
                                                       rdfs:label "Mobile Mitigation" .


###  https://w3id.org/trace-cps/ontology#MobileTactic
<https://w3id.org/trace-cps/ontology#MobileTactic> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Tactic> ;
                                                   rdfs:comment "A tactic defined in the ATT&CK Mobile matrix." ;
                                                   rdfs:label "Mobile Tactic" .


###  https://w3id.org/trace-cps/ontology#MobileTechnique
<https://w3id.org/trace-cps/ontology#MobileTechnique> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/trace-cps/ontology#Technique> ;
                                                      rdfs:comment "A technique defined in the ATT&CK Mobile matrix." ;
                                                      rdfs:label "Mobile Technique" .


###  https://w3id.org/trace-cps/ontology#NetworkLayer
<https://w3id.org/trace-cps/ontology#NetworkLayer> rdf:type owl:Class ;
                                                   rdfs:comment "The network layer of a CPS architecture, comprising routers, switches, gateways, and communication protocols." ;
                                                   rdfs:label "Network Layer" .


###  https://w3id.org/trace-cps/ontology#OS
<https://w3id.org/trace-cps/ontology#OS> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ATT&CK> ;
                                         rdfs:comment "An operating system running on ATT&CK-relevant infrastructure (e.g., Windows, Linux, VxWorks)." ;
                                         rdfs:label "OS" .


###  https://w3id.org/trace-cps/ontology#PerceptionLayer
<https://w3id.org/trace-cps/ontology#PerceptionLayer> rdf:type owl:Class ;
                                                      rdfs:comment "The perception layer of a CPS architecture, comprising sensors and data acquisition devices that interact with the physical environment." ;
                                                      rdfs:label "Perception Layer" .


###  https://w3id.org/trace-cps/ontology#Purpose
<https://w3id.org/trace-cps/ontology#Purpose> rdf:type owl:Class ;
                                              rdfs:comment "The intended objective or target of a cyberattack on a CPS." ;
                                              rdfs:label "Purpose" .


###  https://w3id.org/trace-cps/ontology#RTU
<https://w3id.org/trace-cps/ontology#RTU> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/trace-cps/ontology#CommunicatingEntity> ,
                                                          <https://w3id.org/trace-cps/ontology#Controller> ;
                                          rdfs:comment "A Remote Terminal Unit; a type of controller that monitors field devices and relays data to the supervisory system." ;
                                          rdfs:label "RTU" .


###  https://w3id.org/trace-cps/ontology#RTUFVP
<https://w3id.org/trace-cps/ontology#RTUFVP> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ,
                                                             <https://w3id.org/trace-cps/ontology#VersionPair> ;
                                             rdfs:comment "A pair associating an RTU with a specific firmware version." ;
                                             rdfs:label "RTU Firmware Version Pair" .


###  https://w3id.org/trace-cps/ontology#Result
<https://w3id.org/trace-cps/ontology#Result> rdf:type owl:Class ;
                                             rdfs:comment "The consequence or operational impact caused by a cyberattack on a CPS." ;
                                             rdfs:label "Result" .


###  https://w3id.org/trace-cps/ontology#Router
<https://w3id.org/trace-cps/ontology#Router> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/trace-cps/ontology#NetworkLayer> ;
                                             rdfs:comment "A network router that forwards traffic between network segments in a CPS environment." ;
                                             rdfs:label "Router" .


###  https://w3id.org/trace-cps/ontology#SCADA
<https://w3id.org/trace-cps/ontology#SCADA> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/trace-cps/ontology#ControlLayer> ;
                                            rdfs:comment "A Supervisory Control and Data Acquisition system for real-time monitoring and control of industrial processes." ;
                                            rdfs:label "SCADA" .


###  https://w3id.org/trace-cps/ontology#SecurityTeam
<https://w3id.org/trace-cps/ontology#SecurityTeam> rdf:type owl:Class ;
                                                   rdfs:comment "A defensive security team responsible for monitoring and protecting CPS environments." ;
                                                   rdfs:label "Security Team" .


###  https://w3id.org/trace-cps/ontology#Sensor
