<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/trics/ontology#"
     xml:base="https://w3id.org/trics/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/trics/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/trics/ontology/0.2.0"/>
        <terms:description xml:lang="en">An ontology for representing cyber threats, vulnerabilities, industrial assets, and cross-domain relations in ICS security.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">TrICS Ontology</terms:title>
        <vann:preferredNamespacePrefix>trics</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/trics/ontology#</vann:preferredNamespaceUri>
        <owl:versionInfo>0.2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/trics/ontology#causesResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#causesResult">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ICSTechnique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Result"/>
        <rdfs:comment>A campaign or ICS technique causes an operational consequence on the ICS.</rdfs:comment>
        <rdfs:label>causes Result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#communicatesWithController -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#communicatesWithController">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CommunicatingEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Controller"/>
        <rdfs:comment>A communicating entity (DAQ, HostComputer, RTU, or Sensor) communicates with a controller.</rdfs:comment>
        <rdfs:label>communicates With Controller</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#communicatesWithDAQ -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#communicatesWithDAQ">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#HostComputer"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#DAQ"/>
        <rdfs:comment>A host computer communicates with a DAQ device.</rdfs:comment>
        <rdfs:label>communicates With DAQ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#communicatesWithRTU -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#communicatesWithRTU">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#HostComputer"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#RTU"/>
        <rdfs:comment>A host computer or sensor communicates with an RTU.</rdfs:comment>
        <rdfs:label>communicates With RTU</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#containsTechnique -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#containsTechnique">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Tactic"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Technique"/>
        <rdfs:comment>A tactic contains one or more techniques used to achieve it.</rdfs:comment>
        <rdfs:label>contains Technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#controls -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#controls">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Controller"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Actuator"/>
        <rdfs:comment>A controller drives an actuator to perform physical actions.</rdfs:comment>
        <rdfs:label>controls</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasActuatorVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasActuatorVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Actuator"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#ActuatorFVP"/>
        <rdfs:comment>Relates an actuator to its firmware version pair.</rdfs:comment>
        <rdfs:label>has Actuator Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasAssigner -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasAssigner">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Assigner"/>
        <rdfs:comment>Relates a CVE to the organization that assigned it.</rdfs:comment>
        <rdfs:label>has Assigner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCNVDVulnerability -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasCNVDVulnerability">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVulnerability"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CNVD"/>
        <rdfs:comment>Relates a device version pair to a CNVD vulnerability entry.</rdfs:comment>
        <rdfs:label>has CNVD Vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCVEDescription -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasCVEDescription">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CVEDescription"/>
        <rdfs:comment>Relates a CVE entry to its structured description.</rdfs:comment>
        <rdfs:label>has CVE Description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCVEVulnerability -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasCVEVulnerability">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVulnerability"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:comment>Relates a device version pair to a CVE vulnerability entry.</rdfs:comment>
        <rdfs:label>has CVE Vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCommunicationProtocolVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasCommunicationProtocolVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CommunicationProtocol"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CommunicationProtocolVP"/>
        <rdfs:comment>Relates a communication protocol to its version pair.</rdfs:comment>
        <rdfs:label>has Communication Protocol Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasContainer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasContainer">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Container"/>
        <rdfs:comment>Relates a CVE to its container record holding structured metadata.</rdfs:comment>
        <rdfs:label>has Container</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasControllerVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasControllerVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Controller"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#ControllerFVP"/>
        <rdfs:comment>Relates a controller to its firmware version pair.</rdfs:comment>
        <rdfs:label>has Controller Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasDAQVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasDAQVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#DAQ"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#DAQFVP"/>
        <rdfs:comment>Relates a DAQ device to its firmware version pair.</rdfs:comment>
        <rdfs:label>has DAQ Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasDataComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasDataComponent">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#DataSource"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#DataComponent"/>
        <rdfs:comment>Relates a data source to one of its data components.</rdfs:comment>
        <rdfs:label>has Data Component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasDetection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasDetection">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Technique"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#DataComponent"/>
        <rdfs:comment>Relates a technique to the data components that can be used to detect it.</rdfs:comment>
        <rdfs:label>has Detection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasHMIVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasHMIVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#HMI"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#HMIVP"/>
        <rdfs:comment>Relates an HMI to its software version pair.</rdfs:comment>
        <rdfs:label>has HMI Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasManufacture -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasManufacture">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Manufacturer"/>
        <rdfs:comment>Relates a control-layer device to its manufacturer.</rdfs:comment>
        <rdfs:label>has Manufacture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasMitigation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasMitigation">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Technique"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Mitigation"/>
        <rdfs:comment>Relates a technique to a recommended mitigation measure.</rdfs:comment>
        <rdfs:label>has Mitigation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasPurpose -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasPurpose">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Purpose"/>
        <rdfs:comment>The intended objective or goal pursued by a campaign or threat actor.</rdfs:comment>
        <rdfs:label>has Purpose</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasRTUVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasRTUVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#RTU"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#RTUFVP"/>
        <rdfs:comment>Relates an RTU to its firmware version pair.</rdfs:comment>
        <rdfs:label>has RTU Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasRelatedAsset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasRelatedAsset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Asset"/>
        <rdfs:comment>Relates an ATT&amp;CK asset to another related asset.</rdfs:comment>
        <rdfs:label>has Related Asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasRelatedCWE -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasRelatedCWE">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CWE"/>
        <rdfs:comment>Relates a CVE to the CWE weakness category it belongs to.</rdfs:comment>
        <rdfs:label>has Related CWE</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasSensorVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasSensorVersionPair">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/trics/ontology#hasVersionPair"/>
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#SensorFVP"/>
        <rdfs:comment>Relates a sensor to its firmware version pair.</rdfs:comment>
        <rdfs:label>has Sensor Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasVersionPair -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasVersionPair">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#CommunicationProtocol"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ControlLayer"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#PerceptionLayer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>Relates a device or protocol to its firmware or software version pair.</rdfs:comment>
        <rdfs:label>has Version Pair</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#hasVulnerability -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#hasVulnerability">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Vulnerability"/>
        <rdfs:comment>Relates a device version pair to a known vulnerability.</rdfs:comment>
        <rdfs:label>has Vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#isHostedOnHostComputer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#isHostedOnHostComputer">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#HMI"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#HostComputer"/>
        <rdfs:comment>Indicates that an HMI application is hosted on a host computer.</rdfs:comment>
        <rdfs:label>is Hosted On Host Computer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#launches -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#launches">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ThreatActor"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Campaign"/>
        <rdfs:comment>A threat actor initiates and conducts a campaign.</rdfs:comment>
        <rdfs:label>launches</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#sendsDataToDAQ -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#sendsDataToDAQ">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#DAQ"/>
        <rdfs:comment>A sensor transmits measurement data to a DAQ device.</rdfs:comment>
        <rdfs:label>sends Data To DAQ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#supports -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#supports">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Actuator"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#CommunicatingEntity"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Controller"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#CommunicationProtocol"/>
        <rdfs:comment>A ICS device supports a communication protocol.</rdfs:comment>
        <rdfs:label>supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#targets -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#targets">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Tool"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Software"/>
        <rdfs:comment>A tool targets or operates on a software or system component.</rdfs:comment>
        <rdfs:label>targets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#targetsAsset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#targetsAsset">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ICSTechnique"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Asset"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ControlLayer"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#NetworkLayer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>An ICS technique targets a ICS asset, control-layer device, or network component.</rdfs:comment>
        <rdfs:label>targets Asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#usesInfrastructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#usesInfrastructure">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Infrastructure"/>
        <rdfs:comment>A threat actor or campaign leverages technical infrastructure to support operations.</rdfs:comment>
        <rdfs:label>uses Infrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#usesSoftware -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#usesSoftware">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Software"/>
        <rdfs:comment>A threat actor or campaign uses a specific software tool or malware.</rdfs:comment>
        <rdfs:label>uses Software</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#usesTechnique -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#usesTechnique">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Technique"/>
        <rdfs:comment>A threat actor or campaign employs a specific ATT&amp;CK technique.</rdfs:comment>
        <rdfs:label>uses Technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#utilizes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#utilizes">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Campaign"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Tactic"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#Technique"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Tool"/>
        <rdfs:comment>A threat actor, campaign, technique, or tactic employs a specific tool.</rdfs:comment>
        <rdfs:label>utilizes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/trics/ontology#worksFor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/trics/ontology#worksFor">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#SecurityTeam"/>
        <rdfs:range rdf:resource="https://w3id.org/trics/ontology#Identity"/>
        <rdfs:comment>A security team is affiliated with a parent identity organization.</rdfs:comment>
        <rdfs:label>works For</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/trics/ontology#hasATTCKID -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasATTCKID">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The ATT&amp;CK identifier of an entity (e.g., T1234, TA0001, G0001).</rdfs:comment>
        <rdfs:label>has ATT&amp;CK ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasAnotherName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasAnotherName">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ThreatActor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>An alias or alternative name used for a threat actor.</rdfs:comment>
        <rdfs:label>has Another Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasAssignerName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasAssignerName">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Assigner"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The name of the organization that assigned a CVE identifier.</rdfs:comment>
        <rdfs:label>has Assigner Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCVSSBaseScore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasCVSSBaseScore">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVECVSSVP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The CVSS base score of a vulnerability (e.g., 7.5).</rdfs:comment>
        <rdfs:label>has CVSS Base Score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCVSSBaseSeverity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasCVSSBaseSeverity">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVECVSSVP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The CVSS base severity rating (LOW, MEDIUM, HIGH, or CRITICAL).</rdfs:comment>
        <rdfs:label>has CVSS Base Severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasCVSSVectorString -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasCVSSVectorString">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVECVSSVP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The CVSS vector string encoding the scoring metrics (e.g., CVSS:3.1/AV:N/AC:L/...).</rdfs:comment>
        <rdfs:label>has CVSS Vector String</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasContainerName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasContainerName">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Container"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The name of the container record associated with a CVE entry.</rdfs:comment>
        <rdfs:label>has Container Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasDescription">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of an ATT&amp;CK entity, used to support LLM-based entity alignment, graph fusion, and link prediction.</rdfs:comment>
        <rdfs:label>has Description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasLanguage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasLanguage">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVEDescription"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The language code of a CVE description (e.g., en, zh).</rdfs:comment>
        <rdfs:label>has Language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasPlatform -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasPlatform">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The platform or operating environment applicable to an ATT&amp;CK entity (e.g., Windows, Linux, ICS).</rdfs:comment>
        <rdfs:label>has Platform</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasPublishedDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasPublishedDate">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The date on which a CVE was published.</rdfs:comment>
        <rdfs:label>has Published Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasReference -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasReference">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#CVE"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ATT&amp;CK"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A URL or identifier referencing an external source related to an ATT&amp;CK entity or CVE.</rdfs:comment>
        <rdfs:label>has Reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasRejectedDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasRejectedDate">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The date on which a CVE was rejected.</rdfs:comment>
        <rdfs:label>has Rejected Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasTitle -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasTitle">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The title of a CVE entry.</rdfs:comment>
        <rdfs:label>has Title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasType">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#Actuator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The functional type of an actuator (e.g., motor, valve, pump).</rdfs:comment>
        <rdfs:label>has Type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasUpdatedDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasUpdatedDate">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The date on which a CVE was last updated.</rdfs:comment>
        <rdfs:label>has Updated Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasValue">
        <rdfs:domain rdf:resource="https://w3id.org/trics/ontology#CVEDescription"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The textual content of a CVE description.</rdfs:comment>
        <rdfs:label>has Value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/trics/ontology#hasVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/trics/ontology#hasVersion">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#CommunicationProtocol"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#ControlLayer"/>
                    <rdf:Description rdf:about="https://w3id.org/trics/ontology#PerceptionLayer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The software version or hardware firmware version of a device or protocol.</rdfs:comment>
        <rdfs:label>has Version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/trics/ontology#Actuator -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Actuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:comment>A physical device in the control layer that executes commands from a controller (e.g., motor, valve, pump).</rdfs:comment>
        <rdfs:label>Actuator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#ActuatorFVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#ActuatorFVP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>A pair associating an actuator with a specific firmware version.</rdfs:comment>
        <rdfs:label>Actuator Firmware Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Asset -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Asset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:comment>An ATT&amp;CK ICS asset representing a technology or system component relevant to industrial environments.</rdfs:comment>
        <rdfs:label>Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Assigner -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Assigner">
        <rdfs:comment>The organization (e.g., MITRE, NVD) that assigned a CVE identifier.</rdfs:comment>
        <rdfs:label>Assigner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CNVD -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CNVD">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Vulnerability"/>
        <owl:disjointWith rdf:resource="https://w3id.org/trics/ontology#CVE"/>
        <rdfs:comment>A vulnerability entry from the China National Vulnerability Database.</rdfs:comment>
        <rdfs:label>CNVD</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CVE -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CVE">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Vulnerability"/>
        <rdfs:comment>A Common Vulnerabilities and Exposures entry identifying a publicly known cybersecurity vulnerability.</rdfs:comment>
        <rdfs:label>CVE</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CVECVSSVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CVECVSSVP">
        <rdfs:comment>A pair associating a CVE entry with its CVSS scoring information.</rdfs:comment>
        <rdfs:label>CVE CVSS Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CVEDescription -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CVEDescription">
        <rdfs:comment>A structured textual description of a CVE entry.</rdfs:comment>
        <rdfs:label>CVE Description</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CWE -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CWE">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Weakness"/>
        <rdfs:comment>A Common Weakness Enumeration entry describing a type of software or hardware weakness.</rdfs:comment>
        <rdfs:label>CWE</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Campaign -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Campaign">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:comment>A coordinated set of malicious activities or attacks attributed to a threat actor over a period of time.</rdfs:comment>
        <rdfs:label>Campaign</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CommunicatingEntity -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CommunicatingEntity">
        <rdfs:comment>Abstract parent class for ICS devices that actively initiate communication with controllers or RTUs (DAQ, HostComputer, RTU, Sensor).</rdfs:comment>
        <rdfs:label>Communicating Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CommunicationProtocol -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CommunicationProtocol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#NetworkLayer"/>
        <rdfs:comment>An industrial or network communication protocol used in ICS environments (e.g., Modbus, OPC UA, Profinet, DNP3).</rdfs:comment>
        <rdfs:label>Communication Protocol</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#CommunicationProtocolVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#CommunicationProtocolVP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#NetworkLayer"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>A pair associating a communication protocol with a specific version.</rdfs:comment>
        <rdfs:label>Communication Protocol Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Container -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Container">
        <rdfs:comment>The container record of a CVE entry holding structured vulnerability metadata.</rdfs:comment>
        <rdfs:label>Container</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#ControlLayer -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#ControlLayer">
        <rdfs:comment>The control layer of a ICS architecture, comprising controllers, actuators, HMIs, host computers, and related devices.</rdfs:comment>
        <rdfs:label>Control Layer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Controller -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Controller">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:comment>An industrial controller (e.g., PLC, DCS) that receives commands from the supervisory system and drives actuators. RTU is modelled as a subclass.</rdfs:comment>
        <rdfs:label>Controller</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#ControllerFVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#ControllerFVP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>A pair associating a controller with a specific firmware version.</rdfs:comment>
        <rdfs:label>Controller Firmware Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#DAQ -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#DAQ">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#CommunicatingEntity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#PerceptionLayer"/>
        <owl:disjointWith rdf:resource="https://w3id.org/trics/ontology#Sensor"/>
        <rdfs:comment>A Data Acquisition device that collects measurement data from sensors and transmits it to controllers or host computers.</rdfs:comment>
        <rdfs:label>DAQ</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#DAQFVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#DAQFVP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#PerceptionLayer"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>A pair associating a DAQ device with a specific firmware version.</rdfs:comment>
        <rdfs:label>DAQ Firmware Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#DataComponent -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#DataComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:comment>A sub-category of a data source used to detect ATT&amp;CK techniques.</rdfs:comment>
        <rdfs:label>Data Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#DataSource -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#DataSource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ATT&amp;CK"/>
        <rdfs:comment>An ATT&amp;CK data source representing a system or artifact that can be used to detect adversary techniques.</rdfs:comment>
        <rdfs:label>Data Source</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#EnterpriseMitigation -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#EnterpriseMitigation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Mitigation"/>
        <rdfs:comment>A mitigation measure defined in the ATT&amp;CK Enterprise matrix.</rdfs:comment>
        <rdfs:label>Enterprise Mitigation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#EnterpriseTactic -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#EnterpriseTactic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Tactic"/>
        <rdfs:comment>A tactic defined in the ATT&amp;CK Enterprise matrix.</rdfs:comment>
        <rdfs:label>Enterprise Tactic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#EnterpriseTechnique -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#EnterpriseTechnique">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#Technique"/>
        <rdfs:comment>A technique defined in the ATT&amp;CK Enterprise matrix.</rdfs:comment>
        <rdfs:label>Enterprise Technique</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#Gateway -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#Gateway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#NetworkLayer"/>
        <rdfs:comment>A network gateway connecting different network segments within a ICS environment.</rdfs:comment>
        <rdfs:label>Gateway</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#HMI -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#HMI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:comment>A Human-Machine Interface providing operators with a graphical view of the industrial process and control capabilities.</rdfs:comment>
        <rdfs:label>HMI</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#HMIVP -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#HMIVP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#VersionPair"/>
        <rdfs:comment>A pair associating an HMI with a specific software version.</rdfs:comment>
        <rdfs:label>HMI Software Version Pair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#HostComputer -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#HostComputer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#CommunicatingEntity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/trics/ontology#ControlLayer"/>
        <rdfs:comment>The supervisory host computer in a ICS that issues high-level commands to controllers and hosts SCADA or HMI software.</rdfs:comment>
        <rdfs:label>Host Computer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trics/ontology#ICSMitigation -->


    <owl:Class rdf:about="https://w3id.org/trics/ontology#ICSMitigation">
