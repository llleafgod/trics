    "@value" : "0.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#ATT&CK",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Root class for all MITRE ATT&CK framework concepts, including tactics, techniques, threat actors, campaigns, and mitigations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ATT&CK"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#Actuator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A physical device in the control layer that executes commands from a controller (e.g., motor, valve, pump)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Actuator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#ControlLayer"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#ActuatorFVP",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A pair associating an actuator with a specific firmware version."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Actuator Firmware Version Pair"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#ControlLayer"
  }, {
    "@id" : "https://w3id.org/trics/ontology#VersionPair"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#Asset",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An ATT&CK ICS asset representing a technology or system component relevant to industrial environments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Asset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#ATT&CK"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#Assigner",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The organization (e.g., MITRE, NVD) that assigned a CVE identifier."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Assigner"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CNVD",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A vulnerability entry from the China National Vulnerability Database."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CNVD"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#Vulnerability"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/trics/ontology#CVE"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CVE",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Common Vulnerabilities and Exposures entry identifying a publicly known cybersecurity vulnerability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CVE"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#Vulnerability"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CVECVSSVP",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A pair associating a CVE entry with its CVSS scoring information."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CVE CVSS Version Pair"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CVEDescription",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A structured textual description of a CVE entry."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CVE Description"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CWE",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Common Weakness Enumeration entry describing a type of software or hardware weakness."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CWE"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#Weakness"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#Campaign",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A coordinated set of malicious activities or attacks attributed to a threat actor over a period of time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Campaign"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#ATT&CK"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CommunicatingEntity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Abstract parent class for ICS devices that actively initiate communication with controllers or RTUs (DAQ, HostComputer, RTU, Sensor)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Communicating Entity"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CommunicationProtocol",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An industrial or network communication protocol used in ICS environments (e.g., Modbus, OPC UA, Profinet, DNP3)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Communication Protocol"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#NetworkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#CommunicationProtocolVP",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A pair associating a communication protocol with a specific version."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Communication Protocol Version Pair"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trics/ontology#NetworkLayer"
  }, {
    "@id" : "https://w3id.org/trics/ontology#VersionPair"
  } ]
}, {
  "@id" : "https://w3id.org/trics/ontology#Container",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The container record of a CVE entry holding structured vulnerability metadata."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Container"
  } ]
